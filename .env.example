PORT=8080
BASE_URL=http://localhost:8080
ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Authentication & Security
JWT_SECRET=your-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Whisper Speech-to-Text API
WHISPER_API_URL=http://194.93.48.51:8070
WHISPER_BASE_TOKEN=your-whisper-token

# Google Cloud Storage (GCS)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Admin Defaults
ADMIN_DEFAULT_EMAIL=admin@lexscriptsai.com
ADMIN_DEFAULT_PASSWORD=ChangeMeInProduction!
